NODE_ENV=production
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=https://app.example.org
FRONTEND_URL=https://app.example.org
COOKIE_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@database:5432/ocelot

ZITADEL_ISSUER=https://id.example.org
ZITADEL_CLIENT_ID=replace-with-zitadel-client-id
ZITADEL_CLIENT_SECRET=replace-with-zitadel-client-secret
ZITADEL_REDIRECT_URI=https://api.example.org/auth/callback
ZITADEL_SCOPES=openid profile email offline_access urn:zitadel:iam:org:project:roles
ZITADEL_ROLES_CLAIM=urn:zitadel:iam:org:project:roles

STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
DISCORD_LOG_WEBHOOK_URL=
